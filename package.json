{
  "name": "playlab42",
  "version": "0.2.0",
  "description": "Plateforme modulaire de jeux pour la formation assistée par IA",
  "type": "module",
  "scripts": {
    "serve": "npx serve . -p 5242 -C",
    "build": "npm run build:catalogue && npm run build:parcours && npm run build:bookmarks",
    "build:local": "npm run build:ts && npm run build:catalogue && npm run build:parcours && npm run build:bookmarks -- --skip-og",
    "build:catalogue": "node scripts/build-catalogue.js",
    "build:parcours": "node scripts/build-parcours.js",
    "build:bookmarks": "node scripts/build-bookmarks.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint lib/ games/ tools/ app.js app/ scripts/ parcours/ e2e/ playwright.config.js --ignore-pattern '**/dist/**'",
    "lint:fix": "eslint lib/ games/ tools/ app.js app/ scripts/ parcours/ e2e/ playwright.config.js --ignore-pattern '**/dist/**' --fix",
    "typecheck": "tsc --noEmit",
    "build:ts": "node scripts/build-typescript.js",
    "build:ts:watch": "node scripts/build-typescript.js --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "scaffold": "node scripts/scaffold.js",
    "openspec:list": "openspec list",
    "openspec:validate": "openspec validate --all --strict --no-interactive"
  },
  "keywords": [
    "games",
    "tools",
    "ai",
    "training",
    "javascript"
  ],
  "author": "Docaposte",
  "engines": {
    "node": ">=24"
  },
  "license": "CC-BY-NC-SA-4.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "1.14.0",
    "@playwright/test": "1.63.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lil-gui": "0.19.2",
    "marked": "^18.0.14",
    "mathjax": "3.2.2",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "three": "0.160.0",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  }
}
